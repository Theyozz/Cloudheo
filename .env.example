# --- Backend (FastAPI) ---
ENVIRONMENT=development
DEBUG=true
CORS_ORIGINS=http://localhost:3000
DATABASE_URL=postgresql+psycopg2://cloudheo:cloudheo@localhost:5432/cloudheo

# Fill these in yourself (cloudheo-backend IAM user access key) — do not
# paste real AWS credentials into chat.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-3

# Long random string signing login sessions. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# The default in code is an obvious placeholder — fine for local dev only.
JWT_SECRET_KEY=

# From console.anthropic.com — powers AI explanations of recommendations
# (app/services/ai). Never used for financial calculations, only narration.
ANTHROPIC_API_KEY=

# From resend.com — sends the forgot-password email (app/services/email).
# EMAIL_FROM must be a verified sender/domain in Resend before it can email
# real customers; the default only works for Resend's own test inbox.
RESEND_API_KEY=
EMAIL_FROM=Cloudheo <onboarding@resend.dev>

# Base URL of the running frontend — used to build the link in the
# forgot-password email.
FRONTEND_URL=http://localhost:3000

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
